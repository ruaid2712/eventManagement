# Supabase project values (server-side)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional direct PostgreSQL connection for database tooling/migrations.
DATABASE_URL=postgresql://postgres:your-database-password@db.your-project.supabase.co:5432/postgres

# Local development
CLIENT_ORIGIN=http://localhost:5173
PORT=3001

# Browser-visible Supabase project values; never put the service-role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
VITE_API_URL=/api
